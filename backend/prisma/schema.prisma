generator client {
  provider = "prisma-client-js"
}

datasource db { provider = "mysql" url = env("DATABASE_URL") }
enum UserRole { USER ANALYST ADMIN }
enum UserStatus { ACTIVE SUSPENDED DISABLED }
enum TokenType { ACCESS REFRESH EMAIL_VERIFICATION PASSWORD_RESET PHONE_OTP }
enum SportStatus { ACTIVE INACTIVE }
enum FixtureStatus { SCHEDULED LIVE FINISHED POSTPONED CANCELLED }
model User { id Int @id @default(autoincrement()) email String @unique @db.VarChar(191) phone String? @unique @db.VarChar(32) passwordHash String @db.VarChar(255) firstName String? @db.VarChar(100) lastName String? @db.VarChar(100) role UserRole @default(USER) status UserStatus @default(ACTIVE) emailVerifiedAt DateTime? phoneVerifiedAt DateTime? lastLoginAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt sessions Session[] tokens AuthToken[] auditLogs AuditLog[] settings UserSetting[] @@index([role]) @@index([status]) @@index([createdAt]) @@map("users") }
model Session { id Int @id @default(autoincrement()) userId Int tokenHash String @unique @db.VarChar(255) userAgent String? @db.VarChar(512) ipAddress String? @db.VarChar(64) expiresAt DateTime revokedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId]) @@index([expiresAt]) @@index([revokedAt]) @@map("sessions") }
model AuthToken { id Int @id @default(autoincrement()) userId Int tokenHash String @unique @db.VarChar(255) type TokenType expiresAt DateTime consumedAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,type]) @@index([expiresAt]) @@index([consumedAt]) @@map("auth_tokens") }
model AuditLog { id Int @id @default(autoincrement()) userId Int? action String @db.VarChar(100) entity String? @db.VarChar(100) entityId String? @db.VarChar(100) ipAddress String? @db.VarChar(64) userAgent String? @db.VarChar(512) metadata Json? createdAt DateTime @default(now()) user User? @relation(fields:[userId],references:[id],onDelete:SetNull) @@index([userId]) @@index([action]) @@index([entity,entityId]) @@index([createdAt]) @@map("audit_logs") }
model UserSetting { id Int @id @default(autoincrement()) userId Int key String @db.VarChar(100) value Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([userId,key]) @@index([userId]) @@map("user_settings") }
model Sport { id Int @id @default(autoincrement()) name String @unique @db.VarChar(100) slug String @unique @db.VarChar(100) status SportStatus @default(ACTIVE) iconUrl String? @db.VarChar(500) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt leagues League[] @@index([status]) @@map("sports") }
model League { id Int @id @default(autoincrement()) sportId Int name String @db.VarChar(150) slug String @db.VarChar(150) country String? @db.VarChar(100) logoUrl String? @db.VarChar(500) externalId String? @db.VarChar(100) isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt sport Sport @relation(fields:[sportId],references:[id],onDelete:Cascade) teams Team[] fixtures Fixture[] @@unique([sportId,slug]) @@index([sportId]) @@index([isActive]) @@map("leagues") }
model Team { id Int @id @default(autoincrement()) leagueId Int name String @db.VarChar(150) slug String @db.VarChar(150) shortName String? @db.VarChar(50) country String? @db.VarChar(100) logoUrl String? @db.VarChar(500) externalId String? @db.VarChar(100) isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt league League @relation(fields:[leagueId],references:[id],onDelete:Cascade) players Player[] homeFixtures Fixture[] @relation("HomeTeam") awayFixtures Fixture[] @relation("AwayTeam") @@unique([leagueId,slug]) @@index([leagueId]) @@index([isActive]) @@index([externalId]) @@map("teams") }
model Player { id Int @id @default(autoincrement()) teamId Int name String @db.VarChar(150) slug String @db.VarChar(150) position String? @db.VarChar(50) nationality String? @db.VarChar(100) dateOfBirth DateTime? jerseyNumber Int? photoUrl String? @db.VarChar(500) externalId String? @db.VarChar(100) isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt team Team @relation(fields:[teamId],references:[id],onDelete:Cascade) @@unique([teamId,slug]) @@index([teamId]) @@index([isActive]) @@index([externalId]) @@map("players") }
model Fixture { id Int @id @default(autoincrement()) leagueId Int homeTeamId Int awayTeamId Int externalId String? @unique @db.VarChar(100) kickoffAt DateTime status FixtureStatus @default(SCHEDULED) homeScore Int? awayScore Int? venue String? @db.VarChar(200) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt league League @relation(fields:[leagueId],references:[id],onDelete:Cascade) homeTeam Team @relation("HomeTeam",fields:[homeTeamId],references:[id],onDelete:Cascade) awayTeam Team @relation("AwayTeam",fields:[awayTeamId],references:[id],onDelete:Cascade) @@index([leagueId]) @@index([homeTeamId]) @@index([awayTeamId]) @@index([kickoffAt]) @@index([status]) @@map("fixtures") }
model Prediction { id Int @id @default(autoincrement()) fixtureId Int market String @db.VarChar(100) selection String @db.VarChar(150) confidence Float risk String @db.VarChar(30) odds Float? status String @default("PENDING") result String? @db.VarChar(30) reasoning Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([fixtureId,market,selection]) @@index([fixtureId]) @@index([confidence]) @@index([status]) @@map("predictions") }
model SubscriptionPlan { id Int @id @default(autoincrement()) name String @unique @db.VarChar(100) slug String @unique @db.VarChar(100) price Float @default(0) durationDays Int features Json isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@map("subscription_plans") }
model Subscription { id Int @id @default(autoincrement()) userId Int planId Int status String @default("ACTIVE") startsAt DateTime endsAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([userId]) @@index([status]) @@map("subscriptions") }
model WalletTransaction { id Int @id @default(autoincrement()) userId Int type String @db.VarChar(30) amount Float reference String? @unique @db.VarChar(120) provider String? @db.VarChar(30) status String @default("PENDING") metadata Json? createdAt DateTime @default(now()) @@index([userId]) @@index([type]) @@index([status]) @@map("wallet_transactions") }
model Notification { id Int @id @default(autoincrement()) userId Int title String @db.VarChar(200) message String @db.VarChar(1000) type String @db.VarChar(50) readAt DateTime? createdAt DateTime @default(now()) @@index([userId]) @@index([readAt]) @@map("notifications") }
model Referral { id Int @id @default(autoincrement()) referrerId Int referredUserId Int @unique code String @unique @db.VarChar(32) reward Float @default(0) status String @default("PENDING") createdAt DateTime @default(now()) @@index([referrerId]) @@map("referrals") }
model AdPlacement { id Int @id @default(autoincrement()) key String @unique @db.VarChar(100) name String @db.VarChar(150) type String @db.VarChar(50) content Json? isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@map("ad_placements") }
model GamificationProfile { id Int @id @default(autoincrement()) userId Int @unique points Int @default(0) level Int @default(1) streak Int @default(0) badges Json? updatedAt DateTime @updatedAt @@map("gamification_profiles") }
model CommunityPost { id Int @id @default(autoincrement()) userId Int content String @db.Text likes Int @default(0) status String @default("PUBLISHED") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([userId]) @@index([createdAt]) @@map("community_posts") }
model AnalystProfile { id Int @id @default(autoincrement()) userId Int @unique displayName String @db.VarChar(150) bio String? @db.Text rating Float @default(0) followers Int @default(0) isVerified Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@map("analyst_profiles") }
model WhatsAppLink { id Int @id @default(autoincrement()) userId Int @unique phone String @db.VarChar(32) verifiedAt DateTime? preferences Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@map("whatsapp_links") }
model BetCode { id Int @id @default(autoincrement()) userId Int code String @unique @db.VarChar(120) selections Json stake Float? totalOdds Float? status String @default("ACTIVE") createdAt DateTime @default(now()) @@index([userId]) @@map("bet_codes") }
