generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole { USER ANALYST ADMIN }
enum UserStatus { ACTIVE SUSPENDED DISABLED }
enum TokenType { ACCESS REFRESH EMAIL_VERIFICATION PASSWORD_RESET PHONE_OTP }
enum SportStatus { ACTIVE INACTIVE }

model User {
  id Int @id @default(autoincrement())
  email String @unique @db.VarChar(191)
  phone String? @unique @db.VarChar(32)
  passwordHash String @db.VarChar(255)
  firstName String? @db.VarChar(100)
  lastName String? @db.VarChar(100)
  role UserRole @default(USER)
  status UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  tokens AuthToken[]
  auditLogs AuditLog[]
  settings UserSetting[]
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id Int @id @default(autoincrement())
  userId Int
  tokenHash String @unique @db.VarChar(255)
  userAgent String? @db.VarChar(512)
  ipAddress String? @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model AuthToken {
  id Int @id @default(autoincrement())
  userId Int
  tokenHash String @unique @db.VarChar(255)
  type TokenType
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("auth_tokens")
}

model AuditLog {
  id Int @id @default(autoincrement())
  userId Int?
  action String @db.VarChar(100)
  entity String? @db.VarChar(100)
  entityId String? @db.VarChar(100)
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(512)
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserSetting {
  id Int @id @default(autoincrement())
  userId Int
  key String @db.VarChar(100)
  value Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
  @@index([userId])
  @@map("user_settings")
}

model Sport {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)
  status SportStatus @default(ACTIVE)
  iconUrl String? @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leagues League[]
  @@index([status])
  @@map("sports")
}

model League {
  id Int @id @default(autoincrement())
  sportId Int
  name String @db.VarChar(150)
  slug String @db.VarChar(150)
  country String? @db.VarChar(100)
  logoUrl String? @db.VarChar(500)
  externalId String? @db.VarChar(100)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  @@unique([sportId, slug])
  @@index([sportId])
  @@index([isActive])
  @@map("leagues")
}
