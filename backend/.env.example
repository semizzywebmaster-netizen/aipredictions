NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1

# MySQL
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Frontend origins
FRONTEND_URL=http://localhost:3000

# Authentication secrets - use long random values in production
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Email / SMTP (optional during development; required to send verification and password reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# SMS OTP provider: disabled | log (use a real provider integration in production)
SMS_PROVIDER=disabled
